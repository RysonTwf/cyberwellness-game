{"nodes": [{"id": "design_concept_summary", "label": "Concept summary: single-sitting Atlas journey", "file_type": "document", "source_file": "design.md", "source_location": "L3-10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One 20-30 minute sitting for ages 7-12; each realm teaches one cyber wellness topic via story beat, branching decision, and a hands-on mini-game, tracked by stamps in a passport journal."}, {"id": "design_field_journal_metaphor", "label": "Field-journal / passport metaphor", "file_type": "rationale", "source_file": "design.md", "source_location": "L24-28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grounds the whole product so the internet feels like a nature reserve visited with a guide and a notebook, worth exploring thoughtfully, rather than a void to fear or a screen to be babysat through; every badge is a physical-feeling ink stamp, not a digital trophy."}, {"id": "design_avoided_neon_cyberspace", "label": "Rejected trope: neon-cyberspace-on-black", "file_type": "rationale", "source_file": "design.md", "source_location": "L16-19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark backgrounds, glowing circuits and matrix grids read as scary or hacker-coded, working against the message that the internet is a place kids can explore safely."}, {"id": "design_avoided_ai_default_look", "label": "Rejected trope: warm-cream-and-serif AI default", "file_type": "rationale", "source_file": "design.md", "source_location": "L20-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flattens personality and does not fit an energetic kids' product."}, {"id": "design_color_token_system", "label": "Color token system (paper, ink, realm accents)", "file_type": "concept", "source_file": "design.md", "source_location": "L32-46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each realm accent is used only inside that realm's screens and stamp while hub and shared UI stay ink/paper, so the four colors read as distinct regions of a map rather than a rainbow UI; ink is deep fountain-pen navy and never pure black."}, {"id": "design_type_system", "label": "Type system: Display / Body / Stamp-Label", "file_type": "concept", "source_file": "design.md", "source_location": "L48-58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Baloo 2 or Fredoka for display at large sizes only, Nunito body at 18-20px for age-appropriate readability, and a monospace (Space Mono / IBM Plex Mono) confined to stamps, pins and badge labels because that is what sells the passport-ink signature; it must not leak into body copy."}, {"id": "design_ink_stamp_badge", "label": "Signature element: the ink stamp badge", "file_type": "concept", "source_file": "design.md", "source_location": "L97-106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Irregular-edged circle in realm accent with an arced monospace label, landing at a rotation randomized once per session so the journal feels hand-stamped not templated; it is the one recurring wow moment, so the rest of the UI stays quiet to avoid competing."}, {"id": "design_atlas_hub_layout", "label": "Hub layout: The Atlas", "file_type": "concept", "source_file": "design.md", "source_location": "L62-76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_screen_flow", "label": "Screen flow: gate to Atlas to realms to finale", "file_type": "concept", "source_file": "design.md", "source_location": "L108-126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Realms complete in any order and return to the hub; the finale unlocks only once all four stamps are earned."}, {"id": "design_decision_point_pattern", "label": "Decision point pattern (two choice cards, no dead end)", "file_type": "rationale", "source_file": "design.md", "source_location": "L130-134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selecting the unsafe option shows a brief warm redirect and lets the child pick again, so there is no wrong-answer dead end and nothing punishes or scares."}, {"id": "design_minigame_sort", "label": "Sort mechanic (two labeled bins)", "file_type": "concept", "source_file": "design.md", "source_location": "L137-139", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mechanics are deliberately kept to two and reused across realms with different content so kids do not have to learn new controls each time."}, {"id": "design_minigame_spot", "label": "Spot mechanic (tap flagged items)", "file_type": "concept", "source_file": "design.md", "source_location": "L140-141", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_page_fold_transition", "label": "Page-fold transition", "file_type": "concept", "source_file": "design.md", "source_location": "L142-144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reinforces the journal metaphor between hub and realm screens; kept to ~250-300ms and respects prefers-reduced-motion."}, {"id": "design_component_inventory", "label": "Component inventory for the React build", "file_type": "concept", "source_file": "design.md", "source_location": "L145-156", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_atlasmap", "label": "AtlasMap component", "file_type": "concept", "source_file": "design.md", "source_location": "L147", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_realmscreen", "label": "RealmScreen component", "file_type": "concept", "source_file": "design.md", "source_location": "L148", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_dialoguecard", "label": "DialogueCard component", "file_type": "concept", "source_file": "design.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_choicecard", "label": "ChoiceCard component", "file_type": "concept", "source_file": "design.md", "source_location": "L150", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_minigamesort_component", "label": "MiniGameSort component", "file_type": "concept", "source_file": "design.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_minigamespot_component", "label": "MiniGameSpot component", "file_type": "concept", "source_file": "design.md", "source_location": "L152", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stampbadge_component", "label": "StampBadge component", "file_type": "concept", "source_file": "design.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_journalprogress_component", "label": "JournalProgress component", "file_type": "concept", "source_file": "design.md", "source_location": "L154", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_certificatescreen_component", "label": "CertificateScreen component", "file_type": "concept", "source_file": "design.md", "source_location": "L155", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_state_data_model", "label": "State & data model (travelerName, currentScreen, realmProgress)", "file_type": "concept", "source_file": "design.md", "source_location": "L157-176", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All state lives in useState/useReducer in memory because artifacts cannot use browser storage; persistence via window.storage is flagged as worth adding once the base game is built, not before."}, {"id": "design_accessibility_notes", "label": "Accessibility & kid-safety UX notes", "file_type": "rationale", "source_file": "design.md", "source_location": "L178-187", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Min ~48px tap targets for a touch-first product, no timers or fail states or score pressure, text-equivalent instruction lines, color never the only signal, and no real personal data beyond an in-session first name."}, {"id": "design_technical_constraints", "label": "Technical constraints (artifact-era)", "file_type": "concept", "source_file": "design.md", "source_location": "L189-198", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-file React artifact with Tailwind core utilities only, no localStorage per artifact rules, lucide-react icons, no framer-motion, and no external image assets."}, {"id": "design_scene_construction", "label": "Scene construction (section 9a): art must agree with walkable ground", "file_type": "rationale", "source_file": "design.md", "source_location": "L200-224", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Making realms walkable introduced a constraint the card design never had; failures already caught this way include a bonfire and friends burning on open water, a bog with no bank, and a Keeper hovering twenty units above the ground - it reads immediately as broken to a child."}, {"id": "design_motion_budget", "label": "Motion budget: two spent moments only", "file_type": "rationale", "source_file": "design.md", "source_location": "L226-236", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Animation is spent only on the stamp thunk and the page-fold transition; everything else uses ~150ms opacity/scale changes so nothing bouncy competes with the two signature moments."}], "edges": [{"source": "design_field_journal_metaphor", "target": "design_avoided_neon_cyberspace", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design.md", "source_location": "L12-28", "weight": 1.0}, {"source": "design_field_journal_metaphor", "target": "design_avoided_ai_default_look", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design.md", "source_location": "L12-28", "weight": 1.0}, {"source": "design_field_journal_metaphor", "target": "design_ink_stamp_badge", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design.md", "source_location": "L24-28", "weight": 1.0}, {"source": "design_field_journal_metaphor", "target": "design_page_fold_transition", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design.md", "source_location": "L142-144", "weight": 1.0}, {"source": "design_ink_stamp_badge", "target": "design_type_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design.md", "source_location": "L97-106", "weight": 1.0}, {"source": "design_ink_stamp_badge", "target": "design_color_token_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design.md", "source_location": "L97-106", "weight": 1.0}, {"source": "design_motion_budget", "target": "design_ink_stamp_badge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design.md", "source_location": "L226-236", "weight": 1.0}, {"source": "design_motion_budget", "target": "design_page_fold_transition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design.md", "source_location": "L226-236", "weight": 1.0}, {"source": "d