{"nodes": [{"id": "readme_cyber_wellness_quest", "label": "Cyber Wellness Quest (game overview)", "file_type": "document", "source_file": "README.md", "source_location": "L1-9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_atlas", "label": "The Atlas (map of the internet)", "file_type": "concept", "source_file": "README.md", "source_location": "L3-7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reframes the internet as a explorable map of four islands rather than an abstract network, so a 7-12 year old has a spatial mental model to travel through."}, {"id": "readme_comet", "label": "Comet (paper-airplane guide spirit)", "file_type": "concept", "source_file": "README.md", "source_location": "L3-7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_traveler", "label": "The Traveler (player character)", "file_type": "concept", "source_file": "README.md", "source_location": "L3-7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_passport_stamp", "label": "Passport stamp reward", "file_type": "concept", "source_file": "README.md", "source_location": "L6-7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_wise_traveler_certificate", "label": "Wise Traveler certificate (finale)", "file_type": "concept", "source_file": "README.md", "source_location": "L6-7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_passworld", "label": "Passworld realm (passwords & personal info)", "file_type": "concept", "source_file": "README.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_privacy_peaks", "label": "Privacy Peaks realm (strangers & scams)", "file_type": "concept", "source_file": "README.md", "source_location": "L40", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_bully_bog", "label": "Bully Bog realm (cyberbullying & kindness)", "file_type": "concept", "source_file": "README.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_balance_bay", "label": "Balance Bay realm (screen time balance)", "file_type": "concept", "source_file": "README.md", "source_location": "L42", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_walkable_realm", "label": "Walkable 2D realm scene", "file_type": "concept", "source_file": "README.md", "source_location": "L20-29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each step (story, decision, mini-game, rule) relocates the interaction pin and mutates the scene, so progress is felt as physical change in the world rather than a page advancing."}, {"id": "readme_no_fail_state", "label": "No fail state / warm redirect", "file_type": "rationale", "source_file": "README.md", "source_location": "L31-33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Picking the unsafe option hands the decision straight back with a warm Comet redirect; no dead ends, no timers, and no visible score, so the child is never punished for exploring the wrong answer."}, {"id": "readme_world_scene_coordinate_rule", "label": "scene_y = world_y x 2.8 coordinate conversion", "file_type": "rationale", "source_file": "README.md", "source_location": "L59-71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scene art (560x280 viewBox in RealmArt.jsx) and the walkable band (0-100 world units in data/realms.js) live in different coordinate systems with nothing enforcing agreement; the 2.8 scalar is the only bridge, so both authoring rules hang off it."}, {"id": "readme_solid_ground_rule", "label": "Rule 1: solid ground across the whole walkable band", "file_type": "rationale", "source_file": "README.md", "source_location": "L71-74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Art changes after the safe choice, so ground must hold in both moods; breaking this produced a campfire burning on open water and a Traveler walking across a bog."}, {"id": "readme_no_floating_props_rule", "label": "Rule 2: nothing solid floats above the band", "file_type": "rationale", "source_file": "README.md", "source_location": "L74-76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "World.jsx draws the Traveler over the scene unconditionally with no depth sorting, so any prop above the band makes the player walk in front of something they should pass behind."}, {"id": "readme_scene_contact_sheet", "label": "#art scene contact sheet (dev-only)", "file_type": "concept", "source_file": "README.md", "source_location": "L78-83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overlays the walkable band and every hotspot on all four realms in both moods at once, which is faster at catching ground-rule violations than walking to all sixteen corners by hand."}, {"id": "readme_localstorage_persistence", "label": "localStorage progress persistence (cyber-wellness-quest/v1)", "file_type": "concept", "source_file": "README.md", "source_location": "L87-88", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_svg_only_art", "label": "No image assets: all art is SVG shapes", "file_type": "concept", "source_file": "README.md", "source_location": "L89-90", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every character and scene is built from SVG shapes and fonts are self-hosted via @fontsource, so the built site makes no external requests."}, {"id": "readme_raf_walk_loop", "label": "requestAnimationFrame walk loop with clamped timestep", "file_type": "concept", "source_file": "README.md", "source_location": "L91-94", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pauses in a background tab and resumes with a clamped timestep so the Traveler never teleports; automated tests see a frozen Traveler because browsers throttle rAF to zero in hidden tabs, which is a harness artifact not a bug."}, {"id": "readme_step_panel_portal", "label": "Step panel portalled to body", "file_type": "rationale", "source_file": "README.md", "source_location": "L95-98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".fold animates a perspective()/rotateY() transform, which makes it a containing block, so a position:fixed scrim inside resolves against the realm card instead of the viewport; anything full-screen must be portalled out."}, {"id": "readme_sticky_panel_actions", "label": "Sticky panel action rows", "file_type": "rationale", "source_file": "README.md", "source_location": "L99-101", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".center and .panel-actions stick to the bottom of the panel because a long story beat would otherwise push the only way forward below the fold, and a child who cannot see the button is stuck."}, {"id": "readme_deviation_walkable_world", "label": "Deviation: walkable world replaces card navigation", "file_type": "rationale", "source_file": "README.md", "source_location": "L108-110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "design.md section 5 specified point-and-click cards with no moving character; changed on request so realms are walked, though mini-games remain tap puzzles."}, {"id": "readme_deviation_vite_app", "label": "Deviation: real Vite app instead of single-file artifact", "file_type": "rationale", "source_file": "README.md", "source_location": "L111-113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "design.md section 9 assumed an artifact (Tailwind, no localStorage), but section 7 had already flagged persistence as the follow-up once the base game existed."}, {"id": "readme_deviation_third_minigame", "label": "Deviation: Balance as a third mini-game component", "file_type": "rationale", "source_file": "README.md", "source_location": "L114-117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "design.md section 6 lists only Sort and Spot, but 'Balance the Day' is a scale rather than two bins, so it got its own component while reusing Sort's exact tap-to-place controls so there is no new control to learn."}], "edges": [{"source": "readme_cyber_wellness_quest", "target": "design_concept_summary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L9", "weight": 1.0}, {"source": "readme_atlas", "target": "readme_passworld", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L35-44", "weight": 1.0}, {"source": "readme_atlas", "target": "readme_privacy_peaks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L35-44", "weight": 1.0}, {"source": "readme_atlas", "target": "readme_bully_bog", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L35-44", "weight": 1.0}, {"source": "readme_atlas", "target": "readme_balance_bay", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "L35-44", "weight": 1.0}, {"source": "readme_comet", "target": "readme_no_fail_state", "relation": "implements", "confidence": "EXTRACTED", "conf